<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVC Music Store</title>
    <link rel="stylesheet" href="~/Content/Site.css" />
    <script src="~/Scripts/jquery-1.5.1.min.js"></script>
</head>
<body>
    <div id="header">
        <h1><a href="/">ASP.NET MVC MUSIC STORE</a></h1>
        <ul id="navlist">
            <li class="first"><a href="~/" id="current">Home</a></li>
            <li><a href="~/Store/">Store</a></li>
            <li>@await Component.InvokeAsync("CartSummary")</li>
            <li><a href="~/StoreManager/">Admin</a></li>
        </ul>        
    </div>

    @await Component.InvokeAsync("GenreMenu")

    <div id="main">
        @RenderBody()
    </div>

    <div id="footer">
        built with <a href="http://asp.net/mvc">ASP.NET Core 8.0</a>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>